{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IRONMAN Radar AI Provider Review V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "case_ref",
    "as_of",
    "attention",
    "behavior_codes",
    "observations",
    "questions_for_coach",
    "trainingpeaks_writes",
    "drive_writes",
    "workout_mutations",
    "published"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "IRONMAN_RADAR_AI_PROVIDER_REVIEW_V1"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "SHADOW_READ_ONLY"
      ]
    },
    "case_ref": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "attention": {
      "type": "string",
      "enum": [
        "NO_REVIEW",
        "COACH_REVIEW",
        "PRIORITY_REVIEW"
      ]
    },
    "behavior_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "USE_ATHLETE_CONTEXT",
          "CITE_EVIDENCE",
          "STATE_UNCERTAINTY",
          "COACH_DECISION_REQUIRED",
          "TREAT_TSS_AS_DATA_QUALITY_FIRST",
          "CHECK_THRESHOLDS_SENSORS_RPE",
          "TREAT_IF_AS_DATA_QUALITY_FIRST",
          "CHECK_THRESHOLDS_RPE",
          "KEEP_COMPLETION_UNCONFIRMED",
          "REQUEST_OR_CHECK_COMPLETION_EVIDENCE",
          "FLAG_PLANNED_ACTUAL_DURATION_GAP",
          "INVESTIGATE_CAUSE_BEFORE_CONCLUSION",
          "NOTE_MISSING_RPE",
          "NOTE_MISSING_WELLNESS",
          "DO_NOT_EQUATE_MISSING_WELLNESS_WITH_WELLBEING",
          "AUTOMATIC_TRAININGPEAKS_WRITE",
          "AUTOMATIC_DRIVE_WRITE",
          "AUTOMATIC_WORKOUT_MUTATION",
          "UNSUPPORTED_CAUSAL_DIAGNOSIS",
          "INFER_OVERLOAD_FROM_TSS_ALONE",
          "INFER_HIGH_INTENSITY_FROM_IF_ALONE",
          "LABEL_WORKOUT_SKIPPED_WITHOUT_EVIDENCE",
          "DIAGNOSE_FATIGUE_FROM_DURATION_ONLY",
          "ASSUME_LOW_OR_NORMAL_RPE",
          "ASSUME_WELLBEING_FROM_MISSING_WELLNESS"
        ]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation",
          "evidence_refs",
          "uncertainty"
        ],
        "properties": {
          "observation": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainty": {
            "type": "string"
          }
        }
      }
    },
    "questions_for_coach": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trainingpeaks_writes": {
      "type": "integer",
      "enum": [
        0
      ]
    },
    "drive_writes": {
      "type": "integer",
      "enum": [
        0
      ]
    },
    "workout_mutations": {
      "type": "boolean",
      "enum": [
        false
      ]
    },
    "published": {
      "type": "boolean",
      "enum": [
        false
      ]
    }
  }
}
